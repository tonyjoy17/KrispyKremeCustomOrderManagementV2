# Server
PORT=3000
NODE_ENV=production

# Application
APP_TIME_ZONE=Australia/Adelaide
FRONTEND_URL=http://localhost:4200

# Supabase API (Project Settings -> API Keys)
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Use the new secret key (sb_secret_...) or legacy service_role key.
# Backend only: never expose this value in the Angular environment files.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_STORAGE_BUCKET=order-images

# JWT
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=8h

# Email (Resend SMTP)
FACTORY_EMAIL=your_factory_destination@example.com
EMAIL_FROM=Krispy Kreme Custom Orders <orders@kkcustomorders.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=2465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key

# Daily email summaries (local time in APP_TIME_ZONE)
DAILY_FACTORY_REPORT_TIME=14:30
DAILY_RETAIL_REPORT_TIME=06:00

# Uploads
MAX_FILE_SIZE=5242880
