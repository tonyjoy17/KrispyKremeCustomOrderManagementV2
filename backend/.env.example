# Server
PORT=3000
NODE_ENV=production

# Supabase (Connect > ORMs > transaction pooler)
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_server_only_key
SUPABASE_STORAGE_BUCKET=order-images

# Frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-frontend.onrender.com

# JWT
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=8h

# Email (Gmail SMTP)
FACTORY_EMAIL=factory@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Uploads
MAX_FILE_SIZE=5242880
