PORT=3000
NODE_ENV=development

# Supabase (Settings > API). Keep the service-role key on the backend only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=order-images

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h
APP_TIME_ZONE=Australia/Adelaide

# Email (Factory receives order notifications)
FACTORY_EMAIL=factory@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_app_password

# File uploads (stored in Supabase Storage)
MAX_FILE_SIZE=5242880
FRONTEND_URL=http://localhost:4200
